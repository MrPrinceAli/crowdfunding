# Salin file ini menjadi .env.local, lalu sesuaikan nilainya.
# Setelah mengubah .env.local, restart `npm run dev`.

# Alamat contract Crowdfunding (dicetak oleh `npm run deploy:local`)
NEXT_PUBLIC_CROWDFUNDING_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Jaringan yang dipakai MetaMask
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_NETWORK_NAME=Hardhat Localhost

# Block explorer untuk link bukti transaksi (kosongkan untuk jaringan lokal)
# Contoh Sepolia: https://sepolia.etherscan.io
NEXT_PUBLIC_EXPLORER_URL=
